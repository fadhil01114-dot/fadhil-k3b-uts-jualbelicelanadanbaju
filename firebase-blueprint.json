{
  "entities": {
    "YardBlock": {
      "title": "YardBlock",
      "description": "Container yard block stacking zone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "blockCode": { "type": "string" },
        "capacityTeu": { "type": "number" },
        "currentTeuCount": { "type": "number" },
        "totalRows": { "type": "number" },
        "totalTiers": { "type": "number" },
        "categoryAllowed": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "blockCode", "capacityTeu"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Heavy terminal equipment and cranes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "equipmentType": { "type": "string" },
        "maxCapacityTons": { "type": "number" },
        "operatorName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "equipmentType"]
    },
    "Berth": {
      "title": "Berth",
      "description": "Ship berthing quay terminal master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lengthMeters": { "type": "number" },
        "maxDraft": { "type": "number" },
        "craneCount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "lengthMeters"]
    },
    "ContainerCategory": {
      "title": "ContainerCategory",
      "description": "Container ISO category and handling rates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "type": { "type": "string" },
        "handlingFeePerShift": { "type": "number" }
      },
      "required": ["id", "code", "name", "handlingFeePerShift"]
    },
    "ShippingLine": {
      "title": "ShippingLine",
      "description": "Shipping line company master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lineName": { "type": "string" },
        "isoCode": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "lineName", "email"]
    },
    "VesselCall": {
      "title": "VesselCall",
      "description": "Ship call berthing & loading/unloading transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callSign": { "type": "string" },
        "vesselName": { "type": "string" },
        "shippingLineName": { "type": "string" },
        "berthName": { "type": "string" },
        "eta": { "type": "string" },
        "etd": { "type": "string" },
        "inboundTeu": { "type": "number" },
        "outboundTeu": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "callSign", "vesselName", "berthName", "status"]
    },
    "GateTransaction": {
      "title": "GateTransaction",
      "description": "Container Gate In / Gate Out TOS transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "containerNumber": { "type": "string" },
        "categoryCode": { "type": "string" },
        "sealNumber": { "type": "string" },
        "truckPlate": { "type": "string" },
        "driverName": { "type": "string" },
        "transactionType": { "type": "string" },
        "yardBlockCode": { "type": "string" },
        "yardLocation": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "containerNumber", "truckPlate", "transactionType", "yardBlockCode"]
    },
    "ContainerJob": {
      "title": "ContainerJob",
      "description": "Crane & equipment movement job order log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobCode": { "type": "string" },
        "containerNumber": { "type": "string" },
        "equipmentCode": { "type": "string" },
        "operatorName": { "type": "string" },
        "fromLocation": { "type": "string" },
        "toLocation": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "jobCode", "containerNumber", "equipmentCode"]
    }
  },
  "firestore": {
    "/yardBlocks/{blockId}": {
      "schema": { "$ref": "#/entities/YardBlock" },
      "description": "Master list of container yard blocks"
    },
    "/equipments/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Master list of cranes and heavy equipment"
    },
    "/berths/{berthId}": {
      "schema": { "$ref": "#/entities/Berth" },
      "description": "Master list of terminal quay berths"
    },
    "/containerCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/ContainerCategory" },
      "description": "Master list of container categories and tariffs"
    },
    "/shippingLines/{lineId}": {
      "schema": { "$ref": "#/entities/ShippingLine" },
      "description": "Master list of shipping lines"
    },
    "/vesselCalls/{callId}": {
      "schema": { "$ref": "#/entities/VesselCall" },
      "description": "Transactions of vessel calls & berthing"
    },
    "/gateTransactions/{gateId}": {
      "schema": { "$ref": "#/entities/GateTransaction" },
      "description": "Transactions of Gate In / Out container movements"
    },
    "/containerJobs/{jobId}": {
      "schema": { "$ref": "#/entities/ContainerJob" },
      "description": "Transactions of crane & equipment movement jobs"
    }
  }
}
