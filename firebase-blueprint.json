{
  "entities": {
    "Vessel": {
      "title": "Vessel",
      "description": "Shipping fleet vessel record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "imoNumber": { "type": "string", "maxLength": 20 },
        "vesselType": { "type": "string" },
        "dwtCapacity": { "type": "number" },
        "flag": { "type": "string" },
        "buildYear": { "type": "number" },
        "status": { "type": "string" },
        "captainName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "imoNumber", "vesselType", "dwtCapacity", "status"]
    },
    "Port": {
      "title": "Port",
      "description": "Seaport terminal master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 10 },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "maxDraft": { "type": "number" },
        "berthCapacity": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "city"]
    },
    "CargoType": {
      "title": "CargoType",
      "description": "Cargo categories and freight rates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "standardRatePerUnit": { "type": "number" },
        "unitName": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "standardRatePerUnit", "unitName"]
    },
    "Shipper": {
      "title": "Shipper",
      "description": "Client / Shipper company master record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "npwp": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "creditLimit": { "type": "number" },
        "totalBookings": { "type": "number" }
      },
      "required": ["id", "companyName", "email", "phone"]
    },
    "CrewMember": {
      "title": "CrewMember",
      "description": "Ship crew and officer master record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "rank": { "type": "string" },
        "certificateNo": { "type": "string" },
        "assignedVesselId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "fullName", "rank"]
    },
    "Voyage": {
      "title": "Voyage",
      "description": "Ship voyage schedule and manifest transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "voyageNumber": { "type": "string" },
        "vesselId": { "type": "string" },
        "vesselName": { "type": "string" },
        "originPortId": { "type": "string" },
        "originPortName": { "type": "string" },
        "destinationPortId": { "type": "string" },
        "destinationPortName": { "type": "string" },
        "etd": { "type": "string" },
        "eta": { "type": "string" },
        "status": { "type": "string" },
        "captainName": { "type": "string" },
        "totalFreightValue": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "voyageNumber", "vesselId", "originPortId", "destinationPortId", "etd", "eta", "status"]
    },
    "CargoBooking": {
      "title": "CargoBooking",
      "description": "Cargo shipment booking / Bill of Lading",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingNumber": { "type": "string" },
        "voyageId": { "type": "string" },
        "voyageNumber": { "type": "string" },
        "shipperId": { "type": "string" },
        "shipperName": { "type": "string" },
        "cargoTypeId": { "type": "string" },
        "cargoTypeName": { "type": "string" },
        "quantity": { "type": "number" },
        "totalFreightFee": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "cargoStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "bookingNumber", "voyageId", "shipperId", "cargoTypeId", "quantity", "totalFreightFee", "paymentStatus"]
    },
    "MaintenanceLog": {
      "title": "MaintenanceLog",
      "description": "Vessel maintenance and repair logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vesselId": { "type": "string" },
        "vesselName": { "type": "string" },
        "maintenanceType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "costAmount": { "type": "number" },
        "vendorName": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "vesselId", "maintenanceType", "costAmount", "status"]
    }
  },
  "firestore": {
    "/vessels/{vesselId}": {
      "schema": { "$ref": "#/entities/Vessel" },
      "description": "Master list of shipping fleet vessels"
    },
    "/ports/{portId}": {
      "schema": { "$ref": "#/entities/Port" },
      "description": "Master list of seaports and terminals"
    },
    "/cargoTypes/{cargoTypeId}": {
      "schema": { "$ref": "#/entities/CargoType" },
      "description": "Master list of cargo types and tariff rates"
    },
    "/shippers/{shipperId}": {
      "schema": { "$ref": "#/entities/Shipper" },
      "description": "Master list of shippers and client companies"
    },
    "/crews/{crewId}": {
      "schema": { "$ref": "#/entities/CrewMember" },
      "description": "Master list of ship crew and officers"
    },
    "/voyages/{voyageId}": {
      "schema": { "$ref": "#/entities/Voyage" },
      "description": "Transaction logs of ship voyage schedules"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/CargoBooking" },
      "description": "Transaction logs of cargo bookings & Bill of Lading"
    },
    "/maintenances/{maintenanceId}": {
      "schema": { "$ref": "#/entities/MaintenanceLog" },
      "description": "Transaction logs of vessel repair & maintenance"
    }
  }
}
