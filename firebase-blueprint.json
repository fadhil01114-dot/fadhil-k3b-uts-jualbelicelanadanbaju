{
  "entities": {
    "PassengerShip": {
      "title": "PassengerShip",
      "description": "Passenger and Ro-Ro cargo ship fleet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vesselType": { "type": "string" },
        "passengerCapacity": { "type": "number" },
        "vehicleCapacity": { "type": "number" },
        "cargoCapacityTons": { "type": "number" },
        "captainName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "vesselType", "passengerCapacity"]
    },
    "ShipRoute": {
      "title": "ShipRoute",
      "description": "Ship sailing routes and ports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "routeCode": { "type": "string" },
        "originPort": { "type": "string" },
        "transitPort": { "type": "string" },
        "destinationPort": { "type": "string" },
        "distanceMiles": { "type": "number" },
        "durationHours": { "type": "number" }
      },
      "required": ["id", "routeCode", "originPort", "destinationPort"]
    },
    "TicketClass": {
      "title": "TicketClass",
      "description": "Passenger cabin classes and fares",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "className": { "type": "string" },
        "fareAdult": { "type": "number" },
        "fareChild": { "type": "number" },
        "facilities": { "type": "string" }
      },
      "required": ["id", "className", "fareAdult"]
    },
    "CargoCategory": {
      "title": "CargoCategory",
      "description": "Vehicle and cargo tariff categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryName": { "type": "string" },
        "fareRate": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["id", "categoryName", "fareRate"]
    },
    "TicketAgent": {
      "title": "TicketAgent",
      "description": "Ticketing agents and booking partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agentCode": { "type": "string" },
        "agentName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "agentCode", "agentName"]
    },
    "ShipVoyage": {
      "title": "ShipVoyage",
      "description": "Scheduled ship voyages for passengers and cargo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "voyageCode": { "type": "string" },
        "shipName": { "type": "string" },
        "routeCode": { "type": "string" },
        "originPort": { "type": "string" },
        "destinationPort": { "type": "string" },
        "etd": { "type": "string" },
        "eta": { "type": "string" },
        "bookedPassengers": { "type": "number" },
        "bookedVehicles": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "voyageCode", "shipName", "status"]
    },
    "PassengerTicket": {
      "title": "PassengerTicket",
      "description": "Passenger ticket PNR reservation and boarding log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pnrCode": { "type": "string" },
        "voyageCode": { "type": "string" },
        "passengerName": { "type": "string" },
        "nikNumber": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "ticketClass": { "type": "string" },
        "cabinBedNo": { "type": "string" },
        "fareAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "pnrCode", "voyageCode", "passengerName", "nikNumber", "fareAmount"]
    },
    "CargoManifest": {
      "title": "CargoManifest",
      "description": "Vehicle and freight cargo manifest transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manifestNo": { "type": "string" },
        "voyageCode": { "type": "string" },
        "shipperName": { "type": "string" },
        "cargoCategory": { "type": "string" },
        "itemDescription": { "type": "string" },
        "truckPlate": { "type": "string" },
        "weightTon": { "type": "number" },
        "fareAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "manifestNo", "voyageCode", "shipperName", "fareAmount"]
    }
  },
  "firestore": {
    "/passengerShips/{shipId}": {
      "schema": { "$ref": "#/entities/PassengerShip" },
      "description": "Master list of passenger & cargo fleet ships"
    },
    "/shipRoutes/{routeId}": {
      "schema": { "$ref": "#/entities/ShipRoute" },
      "description": "Master list of ship sailing routes"
    },
    "/ticketClasses/{classId}": {
      "schema": { "$ref": "#/entities/TicketClass" },
      "description": "Master list of ticket classes and fares"
    },
    "/cargoCategories/{catId}": {
      "schema": { "$ref": "#/entities/CargoCategory" },
      "description": "Master list of vehicle & cargo categories"
    },
    "/ticketAgents/{agentId}": {
      "schema": { "$ref": "#/entities/TicketAgent" },
      "description": "Master list of ticketing agents"
    },
    "/shipVoyages/{voyageId}": {
      "schema": { "$ref": "#/entities/ShipVoyage" },
      "description": "Transactions of scheduled ship voyages"
    },
    "/passengerTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/PassengerTicket" },
      "description": "Transactions of passenger tickets PNR"
    },
    "/cargoManifests/{manifestId}": {
      "schema": { "$ref": "#/entities/CargoManifest" },
      "description": "Transactions of vehicle & cargo manifest"
    }
  }
}
