rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Shipping Management Collections: Full read & write for operational app usage
    match /vessels/{vesselId} { allow read, write: if true; }
    match /ports/{portId} { allow read, write: if true; }
    match /cargoTypes/{cargoTypeId} { allow read, write: if true; }
    match /shippers/{shipperId} { allow read, write: if true; }
    match /crews/{crewId} { allow read, write: if true; }
    match /voyages/{voyageId} { allow read, write: if true; }
    match /bookings/{bookingId} { allow read, write: if true; }
    match /maintenances/{maintenanceId} { allow read, write: if true; }
    match /users/{userId} { allow read, write: if true; }
    match /test/{docId} { allow read, write: if true; }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
