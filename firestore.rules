rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Terminal Operating System (TOS) Collections: Open read & write
    match /yardBlocks/{blockId} { allow read, write: if true; }
    match /equipments/{equipmentId} { allow read, write: if true; }
    match /berths/{berthId} { allow read, write: if true; }
    match /containerCategories/{categoryId} { allow read, write: if true; }
    match /shippingLines/{lineId} { allow read, write: if true; }
    match /vesselCalls/{callId} { allow read, write: if true; }
    match /gateTransactions/{gateId} { allow read, write: if true; }
    match /containerJobs/{jobId} { allow read, write: if true; }
    match /users/{userId} { allow read, write: if true; }
    match /test/{docId} { allow read, write: if true; }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
