rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Ship Passenger & Cargo Collections: Open read & write
    match /passengerShips/{shipId} { allow read, write: if true; }
    match /shipRoutes/{routeId} { allow read, write: if true; }
    match /ticketClasses/{classId} { allow read, write: if true; }
    match /cargoCategories/{catId} { allow read, write: if true; }
    match /ticketAgents/{agentId} { allow read, write: if true; }
    match /shipVoyages/{voyageId} { allow read, write: if true; }
    match /passengerTickets/{ticketId} { allow read, write: if true; }
    match /cargoManifests/{manifestId} { allow read, write: if true; }
    match /users/{userId} { allow read, write: if true; }
    match /test/{docId} { allow read, write: if true; }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
